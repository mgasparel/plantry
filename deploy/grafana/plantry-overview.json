{
  "__comment": "Plantry Overview — starter dashboard for the LGTM overlay (deploy/docker-compose.observability.yml). Import via Grafana UI: Dashboards → New → Import → upload this file, then pick the Prometheus/Loki/Tempo datasources (the grafana/otel-lgtm image auto-provisions them). Metric names follow the OTLP→Prometheus translation (dots→underscores, counters gain _total, durations gain _seconds); if a panel shows no data, confirm the exact name in Explore → Prometheus metric browser.",
  "title": "Plantry Overview",
  "uid": "plantry-overview",
  "tags": ["plantry", "starter"],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "time": { "from": "now-24h", "to": "now" },
  "refresh": "1m",
  "schemaVersion": 39,
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "label": "Prometheus",
        "current": {}
      },
      {
        "name": "DS_LOKI",
        "type": "datasource",
        "query": "loki",
        "label": "Loki",
        "current": {}
      },
      {
        "name": "DS_TEMPO",
        "type": "datasource",
        "query": "tempo",
        "label": "Tempo",
        "current": {}
      },
      {
        "name": "model",
        "type": "query",
        "label": "Model",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "query": "label_values(ai_usage_tokens_total, ai_model)",
        "refresh": 2,
        "includeAll": false,
        "multi": false,
        "current": {}
      },
      {
        "name": "service",
        "type": "query",
        "label": "Service",
        "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
        "query": "label_values(service_name)",
        "includeAll": true,
        "multi": true,
        "refresh": 2,
        "current": {}
      },
      {
        "name": "price_input_usd_per_mtok",
        "type": "constant",
        "label": "Input $ / 1M tokens (google/gemini-2.5-flash)",
        "description": "Per-model, per-token-kind pricing lives here (in the dashboard), never in AiOptions or app config, so the volatile pricing table stays out of the codebase (plantry-jp80). Edit via Dashboard settings → Variables when pricing changes; update the matching PromQL model-label filter too if a new model is introduced.",
        "query": "0.30",
        "current": { "value": "0.30", "text": "0.30" },
        "hide": 0
      },
      {
        "name": "price_output_usd_per_mtok",
        "type": "constant",
        "label": "Output $ / 1M tokens (google/gemini-2.5-flash)",
        "description": "See price_input_usd_per_mtok — same rationale, output-token rate.",
        "query": "2.50",
        "current": { "value": "2.50", "text": "2.50" },
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "HTTP",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "Request rate by route",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "fillOpacity": 10 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (http_route) (rate(http_server_request_duration_seconds_count[$__rate_interval]))",
          "legendFormat": "{{http_route}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Request latency (p50 / p95)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "fillOpacity": 10 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_server_request_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "HTTP 5xx rate",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "fillOpacity": 10 },
          "color": { "mode": "fixed", "fixedColor": "red" }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum (rate(http_server_request_duration_seconds_count{http_response_status_code=~\"5..\"}[$__rate_interval]))",
          "legendFormat": "5xx"
        }
      ]
    },
    {
      "type": "logs",
      "title": "Recent logs",
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=~\"$service\"}"
        }
      ]
    },
    {
      "type": "row",
      "title": "AI",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 },
      "collapsed": false
    },
    {
      "type": "table",
      "title": "Recent AI calls (traces)",
      "datasource": { "type": "tempo", "uid": "${DS_TEMPO}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 18 },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "query": "{name=~\"receipt_parse|deal_match|recipe_conversion_seed|recipe_tag_suggest|recipe_diet_nudge\"}",
          "limit": 20
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Receipt-parse confidence (avg per line)",
      "description": "AI-assigned match-confidence for receipt lines (high=1.0, low=0.5, none=0.0).",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 26 },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "max": 1 },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(ai_parse_confidence_sum[$__rate_interval])) / sum(rate(ai_parse_confidence_count[$__rate_interval]))",
          "legendFormat": "avg confidence"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Deal-match confidence (avg per deal)",
      "description": "AI-assigned match-confidence for flyer deals (high=1.0, low=0.5, none=0.0).",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 26 },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "max": 1 },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(ai_deal_match_confidence_sum[$__rate_interval])) / sum(rate(ai_deal_match_confidence_count[$__rate_interval]))",
          "legendFormat": "avg confidence"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "AI tokens by function",
      "description": "sum by (ai_function, ai_token_kind) of increase(ai_usage_tokens_total[...]) — plantry-df6p's shared AiUsageTelemetry.RecordTokenUsage counter. Extended below with price-weighted cost panels (plantry-00lg).",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 26 },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "fillOpacity": 10 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (ai_function, ai_token_kind) (increase(ai_usage_tokens_total[$__rate_interval]))",
          "legendFormat": "{{ai_function}} ({{ai_token_kind}})"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Estimated AI cost by function",
      "description": "Token counts × the price_input_usd_per_mtok / price_output_usd_per_mtok dashboard variables above (per-model pricing lives here, deliberately not in AiOptions — plantry-jp80). The model filter follows the $model variable; update the two price variables when the model or pricing changes.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 34 },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": { "fillOpacity": 10, "stacking": { "mode": "normal" } }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (ai_function) (increase(ai_usage_tokens_total{ai_model=\"$model\", ai_token_kind=\"input\"}[$__rate_interval])) * $price_input_usd_per_mtok / 1000000",
          "legendFormat": "{{ai_function}} (input)"
        },
        {
          "refId": "B",
          "expr": "sum by (ai_function) (increase(ai_usage_tokens_total{ai_model=\"$model\", ai_token_kind=\"output\"}[$__rate_interval])) * $price_output_usd_per_mtok / 1000000",
          "legendFormat": "{{ai_function}} (output)"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Estimated AI cost (selected range)",
      "description": "Total estimated spend across all functions and token kinds for the dashboard's selected time range, at the prices set in the price_input_usd_per_mtok / price_output_usd_per_mtok variables above. The model filter follows the $model variable; update the two price variables when the model or pricing changes.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 4, "x": 12, "y": 34 },
      "fieldConfig": {
        "defaults": { "unit": "currencyUSD" },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(ai_usage_tokens_total{ai_model=\"$model\", ai_token_kind=\"input\"}[$__range])) * $price_input_usd_per_mtok / 1000000 + sum(increase(ai_usage_tokens_total{ai_model=\"$model\", ai_token_kind=\"output\"}[$__range])) * $price_output_usd_per_mtok / 1000000"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "AI calls per function (rate, sanity check)",
      "description": "Call rate of AI spans by function name (span names = the AiFunction taxonomy: receipt_parse, deal_match, recipe_conversion_seed, recipe_tag_suggest, recipe_diet_nudge), sourced from Tempo's span-metrics generator remote-writing traces_spanmetrics_calls_total into the bundled Prometheus. Cross-check against the token/cost panels — a function with cost but no call-rate (or vice versa) means one of the two pipelines is broken.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 34 },
      "fieldConfig": {
        "defaults": { "unit": "cps", "custom": { "fillOpacity": 10 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (span_name) (rate(traces_spanmetrics_calls_total{span_name=~\"receipt_parse|deal_match|recipe_conversion_seed|recipe_tag_suggest|recipe_diet_nudge\"}[$__rate_interval]))",
          "legendFormat": "{{span_name}}"
        }
      ]
    },
    {
      "type": "row",
      "title": "Household activity",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 42 },
      "collapsed": false
    },
    {
      "type": "stat",
      "title": "Intake sessions committed",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 43 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(plantry_intake_sessions_committed_total[$__range]))"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Stock consume operations",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 43 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(plantry_inventory_stock_consumed_total[$__range]))"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Recipes cooked",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 43 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(plantry_recipes_cooked_total[$__range]))"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Low-stock events",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 43 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(plantry_inventory_low_stock_events_total[$__range]))"
        }
      ]
    }
  ]
}
