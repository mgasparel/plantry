@page
@model Plantry.Web.Pages.Intake.HistoryModel
@{
    ViewData["Title"] = "Intake history";
}

@*
    SPEC/receipt-intake-history.md H5 — /Intake/History. Month-grouped data-grid (store / date / status
    badge / source / items / total), reached from the Upload page's Recent-intakes panel "View all" link
    (H12). Covers both intake kinds (plantry-45ba — receipt intake and manual intake are both purchases
    and share this one history), each row's Source column badging which one it was. "Show earlier"
    (_HistoryBlocks.cshtml) htmx-appends the next page of month blocks.
*@
<page-header eyebrow="🧾 Intakes" title="Intake history"
             subtitle="Every purchase you've logged — scanned or typed — and what it added to your pantry.">
    <a class="btn btn--secondary" href="@Url.Page("/Intake/Upload")">
        <svg class="icon" aria-hidden="true"><use href="#i-camera" /></svg> Scan receipt
    </a>
    <a class="btn btn--primary" href="@Url.Page("/Intake/Manual")">
        <svg class="icon" aria-hidden="true"><use href="#i-edit" /></svg> Enter a purchase
    </a>
</page-header>

@if (Model.MonthBlocks.Count == 0 && Model.NextCursor is null)
{
    <div class="empty-state">
        <div class="empty-state__title">No intakes yet</div>
        <div class="empty-state__body">Scan a receipt or enter a purchase to start building your history.</div>
    </div>
}
else
{
    <div id="intake-history-list">
        <partial name="_HistoryBlocks" model="Model" />
    </div>
}
