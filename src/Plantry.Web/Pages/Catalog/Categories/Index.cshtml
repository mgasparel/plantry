@page
@model Plantry.Web.Pages.Catalog.Categories.IndexModel
@using Plantry.Web.Pages.Shared
@{
    ViewData["Title"] = "Categories";

    var isSorted = IndexModel.IsSortedRequest(Model.Sort);
    var categoryRows = new RowListViewModel(
        Model.Categories
            .Select(c => new RowListItem(
                c.Name,
                Secondary: c.DefaultDueDays is { } days ? $"Default expiry: {days} days" : "No default expiry",
                Id: c.Id.Value.ToString(),
                SortOrder: c.SortOrder))
            .ToList(),
        EmptyMessage: "No categories yet — add your first one below.",
        Reorderable: !isSorted,
        ReorderUrl: isSorted ? null : Url.Page("./Index", "Reorder"),
        Deletable: true);
}

<page-header title="Categories" subtitle="Group products into categories and set a default expiry window for each." />

<div asp-validation-summary="ModelOnly" class="alert alert--danger" role="alert"></div>

<section class="catalog-section">
    <div class="field field--inline">
        <label for="category-sort" class="field__label">Sort categories</label>
        <form id="category-sort-form" method="get">
            <select id="category-sort" name="sort" class="field__input" onchange="this.form.submit()">
                <option value="name" selected="@(Model.Sort == "name" && !Model.Desc ? "selected" : null)">Name (A–Z)</option>
                <option value="name-desc" selected="@(Model.Sort == "name" && Model.Desc ? "selected" : null)">Name (Z–A)</option>
                <option value="expiry" selected="@(Model.Sort == "expiry" && !Model.Desc ? "selected" : null)">Default expiry (soonest)</option>
                <option value="expiry-desc" selected="@(Model.Sort == "expiry" && Model.Desc ? "selected" : null)">Default expiry (latest)</option>
            </select>
        </form>
        @if (isSorted)
        {
            <p class="field__hint">Drag reordering is disabled in sorted views. Your persisted manual order is unchanged.</p>
        }
    </div>
    <partial name="Shared/_RowList" model="categoryRows" />
</section>

<section class="catalog-section">
    <h2 class="catalog-section__heading">Add a category</h2>
    <form method="post" asp-page-handler="Create" class="form-stack">
        <div class="field field--inline">
            <label asp-for="Input.Name" class="field__label">Name</label>
            <input asp-for="Input.Name" class="field__input" placeholder="e.g. Dairy" />
            <span asp-validation-for="Input.Name" class="field__error"></span>
        </div>
        <div class="field field--inline">
            <label asp-for="Input.DefaultDueDays" class="field__label">Default expiry (days)</label>
            <input asp-for="Input.DefaultDueDays" class="field__input" type="number" min="0" />
            <span asp-validation-for="Input.DefaultDueDays" class="field__error"></span>
        </div>
        <button type="submit" class="btn btn--primary">Create category</button>
    </form>
</section>
