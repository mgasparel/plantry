@model Plantry.Web.Pages.MealPlan.IndexModel.GridWithBarNavVm
@* Response for any full-grid swap (Grid nav, Generate, AcceptAll, Discard, AcceptCell, RejectCell, Move).
   Emits the week grid as the primary swap target followed by an OOB plan-bar nav refresh and an
   OOB Shop-button refresh so the command bar AND the Shop control stay coherent with the loaded
   week after every htmx grid swap.
   Without the plan-bar OOB fragment the nav URLs, week label, This-week button visibility,
   Auto-fill state, and budget chip all drift from the displayed grid — the staleness bug
   plantry-khw fixes. Without the Shop-button OOB fragment, the Shop control keeps its Alpine
   weekDate from the initial page-load week forever — the staleness bug plantry-pl5u fixes: the
   Shop control lived outside this swapped fragment entirely and never re-hydrated, so
   Previous/Next/This-week navigation left it posting the wrong week. *@
@await Html.PartialAsync("_WeekGrid", Model.Grid)
@await Html.PartialAsync("_PlanBarNav", Model.BarNav)
@await Html.PartialAsync("_ShopButton", Model.ShopButton)
