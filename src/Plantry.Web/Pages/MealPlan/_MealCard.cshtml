@model Plantry.Web.Pages.MealPlan.IndexModel.MealCardVm
@{
    var meal = Model.Meal;
    var isNote = meal.Note is not null;
    var enr = meal.Enrichment;

    // Fulfillment level class — mirrors PL.lvl() from prototype: >=80 hi, >=50 mid, else lo
    string FulfLevel(int pct) => pct >= 80 ? "hi" : pct >= 50 ? "mid" : "lo";

    // Cook strip (plantry-0eut): derived cooked/eaten state, never a stored plan flag. Every dish gets
    // a row once the strip renders — pending recipe (Cook link), pending product (Eat button,
    // plantry-zcbx), or done (settled row, either kind).
    var cookDishes = meal.Dishes ?? new List<Plantry.Web.Pages.MealPlan.IndexModel.MealCardDishVm>();
    var showStrip = !isNote && meal.ShowCookStrip;
    var stripRows = showStrip ? cookDishes : new List<Plantry.Web.Pages.MealPlan.IndexModel.MealCardDishVm>();
    var allDishesDone = showStrip && cookDishes.Count > 0 && cookDishes.All(d => d.CookedAt.HasValue);
    var cellId = $"cell-{Model.SlotId.Value:N}-{Model.DateIso}";

    // Per-card accessible-name context (plantry-rhxv): a week grid renders up to 21 cards, and both
    // the hidden open-details button and the edit pencil previously shared one static label across
    // every card ("Open meal details" / "Edit meal") — indistinguishable to a screen-reader user
    // tabbing the grid. Day name + date + slot is stable and unique per card; deliberately NOT dish
    // names/note text (spec:ready notes on plantry-rhxv) — those can be long, absent, or plural.
    var cardDate = DateOnly.ParseExact(Model.DateIso, "yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture);
    var cardContext = $"{cardDate:dddd} {cardDate:MMM d}, {Model.SlotLabel}";
    // plantry-0m9h: two-or-more meals in one slot render byte-identical cardContext above (same
    // day+date+slot), so both cards' accessible names still collide — append a 1-based positional
    // ordinal to disambiguate. Suppressed entirely when this is the slot's only meal (MealCount == 1)
    // so every existing single-meal card keeps today's label byte-for-byte. Option B (dish/note text)
    // and option C (accept the collision) were both rejected by the owner (plantry-rhxv, 2026-07-28) —
    // do not substitute dish names here.
    if (Model.MealCount > 1)
    {
        cardContext += $" (meal {Model.MealOrdinal} of {Model.MealCount})";
    }

    // plantry-ely3: click-anywhere-opens-editor. Shared with the pencil's own onclick so both
    // paths call the identical island bridge signature. The card-level handler guards against
    // double-invocation (and against hijacking nested actions — Cook link, Eat/Undo, pencil) by
    // bailing when the event target is itself (or is nested inside) an <a> or <button>; those
    // elements' own onclick/href handles the action instead.
    var openEditorCall = $"window.__mealPlannerIsland && window.__mealPlannerIsland.openEditor('{Model.DateIso}', '{Model.SlotId.Value}', '{meal.MealId:D}')";
}

<div class="meal-card @(isNote ? "note" : "") @(allDishesDone ? "cooked" : "")"
     draggable="true"
     ondragstart="onDragStart(event, '@meal.MealId.ToString("D")', '@Model.DateIso', '@Model.SlotId.Value')"
     onclick="if (!event.target.closest('a,button')) { @openEditorCall }">

    @* Keyboard/AT primary activation control (a11y fix, plantry-bg2v): role="button" on the card
       itself was invalid — a button role must not wrap other interactive elements (the pencil,
       cook-strip actions, Cook link), all of which it did. This hidden button is the sole
       keyboard/AT entry point; mouse users keep click-anywhere via the div's onclick above. Native
       <button> semantics mean no onkeydown handler is needed (Enter/Space are built in). *@
    <button class="mc-open-details sr-only" type="button" onclick="@openEditorCall" aria-label="Open meal details — @cardContext">
        Open meal details
    </button>

    @* Edit pencil — calls the meal-planner island bridge (plantry-2zvm.4: Preact island port).
       Redundant with the card-level click-anywhere handler above (plantry-ely3); kept as a
       discoverable affordance and explicit keyboard/focus target. *@
    <button class="mc-edit"
            onclick="window.__mealPlannerIsland && window.__mealPlannerIsland.openEditor('@Model.DateIso', '@Model.SlotId.Value', '@meal.MealId.ToString("D")')"
            aria-label="Edit meal — @cardContext">
        <svg class="icon" aria-hidden="true"><use href="#i-edit" /></svg>
    </button>

    @if (isNote)
    {
        @* Note card variant *@
        <div class="note-ico">
            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 9v4M12 17h.01M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z" /></svg>
        </div>
        <div class="note-txt">@meal.Note</div>
        <div class="note-sub">Free note · no dishes</div>
    }
    else
    {
        @* Recipe photo (plantry-tyvg): the primary recipe dish — the first Recipe-kind dish in
           ordinal order, mirroring Today's "primary recipe" convention (Today/Index.cshtml.cs) —
           renders its stored photo via the Recipes photo endpoint when it has one. When the meal has
           NO Recipe-kind dish at all, the first Product-kind dish stands in instead (plantry-f4dt) —
           its inherited photo (PhotoRecipeId, sole photo-bearing producer-recipe) renders through the
           same endpoint. Every other case (no dishes, note meals, a primary dish with no [inherited]
           photo) falls back to the gradient placeholder so the tile never shows a broken-image icon.
           Deliberately no precedence logic beyond "first recipe dish wins if one exists" — a meal
           with both a photo-less recipe dish and a photo-resolvable product dish still shows the
           placeholder (spec:ready, plantry-f4dt behavior rule 1). *@
        var primaryDish = cookDishes.FirstOrDefault(d => d.Kind == Plantry.MealPlanning.Domain.DishKind.Recipe)
            ?? cookDishes.FirstOrDefault(d => d.Kind == Plantry.MealPlanning.Domain.DishKind.Product);
        var showPhoto = primaryDish is not null && primaryDish.HasPhoto;
        var photoRecipeId = primaryDish is null
            ? (Guid?)null
            : primaryDish.Kind == Plantry.MealPlanning.Domain.DishKind.Recipe ? primaryDish.ItemId : primaryDish.PhotoRecipeId;
        <div class="mc-photo">
            @if (showPhoto)
            {
                <img class="mc-photo-img" src="/Recipes/@photoRecipeId?handler=Photo" alt="@primaryDish!.Name" loading="lazy" />
            }
            else
            {
                <div class="mc-photo-img placeholder" style="background:linear-gradient(152deg,oklch(0.72 0.09 150),oklch(0.5 0.12 150))">
                    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 3h12a1 1 0 0 1 1 1v14H7a2 2 0 0 0-2 2V3Z" /><path d="M18 18v3H7a2 2 0 0 1-2-2" /><path d="M9 7h5M9 10h5" /></svg>
                </div>
            }
            <div class="mc-photo-scrim"></div>
            @* Use-soon badge — shown when any ingredient expires within the per-household expiring-soon horizon (P3-4) *@
            @if (enr is not null && enr.HasExpiringIngredients)
            {
                <span class="mc-soon" title="Ingredients expiring soon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 9v4M12 17h.01" /><path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z" /></svg>
                    Use soon
                </span>
            }
            @* Fully-cooked badge — every dish in the meal is done (plantry-0eut); pairs with the
               .meal-card.cooked grayscale photo filter applied via the class on the outer card. *@
            @if (allDishesDone)
            {
                <span class="mc-cooked">
                    <svg aria-hidden="true"><use href="#i-check" /></svg>
                    Cooked
                </span>
            }
        </div>
        <div class="mc-body">
            <div class="mc-dishes">
                @for (int i = 0; i < meal.DishNames.Count; i++)
                {
                    <div class="mc-dish">
                        @if (i > 0) { <span class="md-plus">+</span> }
                        <span class="md-name">@meal.DishNames[i]</span>
                    </div>
                }
            </div>
            <div class="mc-spacer"></div>
            <div class="mc-bodyfoot">
                @if (enr is not null)
                {
                    var lvl = FulfLevel(enr.FulfillmentPercent);
                    @* Live fulfillment % with colour-coded dot (P3-4) *@
                    <span class="mc-fulf lvl-@lvl">
                        <span class="fdot lvl-@(lvl)-bg"></span>
                        <span>@enr.FulfillmentPercent%</span>
                    </span>
                    <span class="mc-sep"></span>
                    @* Estimated cost (P3-4) *@
                    @if (enr.TotalCost.HasValue)
                    {
                        <span class="mc-cost">@(enr.CostIsPartial ? "~" : "")@MoneyDisplay.Format(enr.TotalCost.Value, Model.DisplayCurrency)</span>
                    }
                    else
                    {
                        <span class="mc-cost" style="color:var(--color-text-faint)">—</span>
                    }
                }
                else
                {
                    @* Note meals and empty dishes: no enrichment *@
                    <span class="mc-fulf">
                        <span class="fdot" style="background:var(--color-text-faint)"></span>
                        <span>—%</span>
                    </span>
                    <span class="mc-sep"></span>
                    <span class="mc-cost">—</span>
                }
            </div>
            @if (meal.EffectiveAttendees.Count > 0)
            {
                <div class="mc-att-row">
                    <span class="mc-att">
                        @foreach (var uid in meal.EffectiveAttendees.Take(3))
                        {
                            var member = Model.Members.FirstOrDefault(m => m.UserId == uid);
                            if (member is not null)
                            {
                                <span class="pl-av" data-av-color="@(Model.Members.IndexOf(member) % 8)" style="width:18px;height:18px;font-size:7px;" title="@member.DisplayName">@member.Initials</span>
                            }
                        }
                        @if (meal.EffectiveAttendees.Count > 3)
                        {
                            <span class="pl-av" style="width:18px;height:18px;font-size:7px;" title="More attendees">+@(meal.EffectiveAttendees.Count - 3)</span>
                        }
                    </span>
                </div>
            }
        </div>
        @* Cook strip — footer zone below mc-body, today/past dish-based meals only (plantry-0eut).
           Per pending recipe dish: a Cook deep-link. Per pending product dish: an Eat button
           (plantry-zcbx) that POSTs one consume and re-renders this cell. Per done dish: a settled
           row — today's eaten product gets an Undo button in place of the timestamp (Undo stays live
           all of today, never on a past date); every other done row shows its timestamp. *@
        @if (stripRows.Count > 0)
        {
            <div class="mc-cook-strip">
                @foreach (var dish in stripRows)
                {
                    var isProduct = dish.Kind == Plantry.MealPlanning.Domain.DishKind.Product;
                    if (dish.CookedAt is not null)
                    {
                        var verb = isProduct ? "Eaten" : "Cooked";
                        <div class="mc-cook-done">
                            <svg class="icon" aria-hidden="true"><use href="#i-check" /></svg>
                            @verb · @dish.Servings@(isProduct ? " " + dish.UnitCode : " srv")
                            @if (isProduct && meal.IsToday)
                            {
                                <button class="undo" type="button"
                                        hx-post="/MealPlan?handler=UndoEat&amp;plannedDishId=@dish.DishId&amp;date=@Model.DateIso&amp;slotId=@Model.SlotId.Value"
                                        hx-target="#@cellId" hx-swap="outerHTML">
                                    Undo
                                </button>
                            }
                            else
                            {
                                <span class="done-meta">@dish.CookedAtLocalTime</span>
                            }
                        </div>
                    }
                    else if (isProduct)
                    {
                        @* Pending product dish: one-tap Eat by default — no confirmation dialog
                           (shortfall never blocks, C8/R9 mirror). "Multi-dish" naming mirrors the Cook
                           link below. plantry-yuy3: when consuming the planned quantity would leave a
                           <=10%-of-on-hand sliver (dish.NeedsEatConfirm, computed server-side at render
                           time — Plantry.MealPlanning.Domain.UseUpZone.IsInUseUpZone), Eat itself opens
                           the confirm sheet instead of consuming directly, so a household doesn't get
                           stuck with a useless dangling remainder. Either way, the secondary "Adjust
                           quantity" icon button below always opens the same sheet, on demand. *@
                        var eatLabel = cookDishes.Count > 1 ? $"Eat {dish.Name}" : "Eat";
                        var eatSheetUrl = $"/MealPlan?handler=EatSheet&plannedDishId={dish.DishId}&date={Model.DateIso}&slotId={Model.SlotId.Value}";
                        var eatPostUrl = $"/MealPlan?handler=Eat&plannedDishId={dish.DishId}&date={Model.DateIso}&slotId={Model.SlotId.Value}";
                        <div class="mc-cook-row">
                            @* One button either way — hx-get/hx-post are conditional expressions so
                               Razor omits whichever is null (standard conditional-attribute rendering),
                               instead of writing the whole button twice for a 4-attribute difference. *@
                            <button class="mc-cook-act eat" type="button"
                                    hx-get="@(dish.NeedsEatConfirm ? eatSheetUrl : null)"
                                    hx-post="@(dish.NeedsEatConfirm ? null : eatPostUrl)"
                                    hx-target="@(dish.NeedsEatConfirm ? "#sheet-host" : "#" + cellId)"
                                    hx-swap="@(dish.NeedsEatConfirm ? "innerHTML" : "outerHTML")">
                                <svg class="icon" aria-hidden="true"><use href="#i-flame" /></svg>
                                <span class="act-name">@eatLabel</span>
                                <span class="act-srv">@dish.Servings @dish.UnitCode</span>
                            </button>
                            <button class="mc-cook-act-adjust" type="button"
                                    hx-get="@eatSheetUrl"
                                    hx-target="#sheet-host" hx-swap="innerHTML"
                                    title="Adjust quantity before eating"
                                    aria-label="Adjust quantity — @eatLabel">
                                <svg class="icon" aria-hidden="true"><use href="#i-edit" /></svg>
                            </button>
                        </div>
                    }
                    else
                    {
                        @* Pending recipe dish. "Multi-dish" label is keyed on the MEAL's total dish
                           count, not the strip's row count, so a pending recipe dish alongside a
                           pending product dish still gets the disambiguating name. *@
                        var label = cookDishes.Count > 1 ? $"Cook {dish.Name}" : "Cook";
                        <a class="mc-cook-act"
                           href="/Recipes/@dish.ItemId/Cook?servings=@dish.Servings&amp;plannedDishId=@dish.DishId&amp;eatingTonight=@meal.EatingTonight">
                            <svg class="icon" aria-hidden="true"><use href="#i-flame" /></svg>
                            <span class="act-name">@label</span>
                            <span class="act-srv">@dish.Servings srv</span>
                        </a>
                    }
                }
            </div>
        }
    }
</div>
