@page "{id:guid}"
@model Plantry.Web.Pages.Pantry.Products.DetailModel
@using Plantry.Web.Pages.Shared
@{
    ViewData["Title"] = Model.Detail?.Name ?? "Product";

    // Zero-stock landing (plantry-sjfn): a product with no active lots — either never stocked at all
    // (the Pantry "Everything" scope links catalog-only products straight here) or consumed down to
    // zero — gets "Add stock" as the header's primary action instead of Consume (_PrimaryStockAction).
    var hasStock = Model.Detail!.Lots.Count > 0;

    // "Recipes" section (plantry-o0r8) — which household recipes directly reference this product, either
    // as a consumer ("Used in") or as the recipe's declared cook yield ("Made by"). Both roles are folded
    // into one badge label when a recipe is somehow both (rare — same product as ingredient and yield).
    // Row-list, not a DataGrid (plantry-sbpk) — mirrors the Lots redesign: a near-empty table of one or
    // two rows read as database-admin chrome, not a pantry.
    static string RoleLabel(Plantry.Recipes.Application.RecipeProductUsage u)
    {
        var roles = new List<string>();
        if (u.IsConsumer) roles.Add("Used in");
        if (u.IsProducer) roles.Add("Made by");
        return string.Join(" · ", roles);
    }
    static string RoleToneClass(Plantry.Recipes.Application.RecipeProductUsage u) =>
        u.IsProducer && !u.IsConsumer ? "badge--success" : "badge--info";
}

@* Shared .page-header primitive (plantry-7yf1): category -> eyebrow, name -> title. The header carries
   only the primary stock action now (plantry-sbpk) — Set alert/Set price moved onto their own vitals
   tiles, and the on-hand total moved into the vitals strip's On-hand tile, so no page-header subtitle
   is passed here any more.
   Cross-link to the catalog view (plantry-kkeg): always live — a pantry product always has a
   catalog record. *@
<page-header eyebrow="@Model.Detail.CategoryName" title="@Model.Detail.Name"
             cross-link-text="View in catalog →"
             cross-link-href="@Url.Page("/Catalog/Products/Detail", new { id = Model.ProductId })">
    <partial name="_PrimaryStockAction" model="new Plantry.Web.Pages.Pantry.Products.PrimaryStockActionPartialModel(Model.ProductId, hasStock, false)" />
</page-header>

@* Vitals strip (plantry-sbpk): On hand / Next expiry / Price / Low-stock alert — a 4-up stat grid
   (intake-detail .stat-grid precedent) replacing the old grey subtitle and orphan price line. The
   On-hand/Next-expiry/Low-stock-alert tiles come from _VitalsTiles (OOB-refreshed by _StockDetail on
   every stock mutation); the Price tile is _PriceDisplay, refreshed independently by "Set price" alone
   (see VitalsTilesPartialModel's doc comment for why price is split out). CSS `order` on each tile
   restores the On hand / Next expiry / Price / Low-stock alert reading order despite Price rendering
   out of DOM sequence. *@
<div class="vitals">
    <partial name="_VitalsTiles" model="new Plantry.Web.Pages.Pantry.Products.VitalsTilesPartialModel(Model.Detail, false, Model.TodayDate, Model.ExpiringSoonDays)" />
    <partial name="_PriceDisplay" model="new Plantry.Web.Pages.Pantry.Products.PriceDisplayPartialModel(Model.ProductId, Model.PriceDisplayText, false)" />
</div>

<partial name="_StockDetail" model="new Plantry.Web.Pages.Pantry.Products.StockDetailPartialModel(Model.Detail, false, null, Model.Chips, Model.AmendableLines, Model.HistoryWhenLocal, Model.TodayDate, Model.ExpiringSoonDays)" />

@* Product→recipes cross-context read (plantry-o0r8): every household recipe that directly references
   this product, either as an ingredient ("Used in") or as its declared cook yield ("Made by"). *@
<section class="catalog-section">
    <h2 class="catalog-section__heading">Recipes</h2>
    @if (Model.RecipeUsages.Count == 0)
    {
        <p class="empty-state">Not used in any recipes yet.</p>
    }
    else
    {
        <div class="catalog-list">
            @foreach (var usage in Model.RecipeUsages)
            {
                <div class="catalog-list__item">
                    <a class="recipe-row__name" href="@Url.Page("/Recipes/Details", new { id = usage.RecipeId })">@usage.Name</a>
                    <span class="badge @RoleToneClass(usage)">@RoleLabel(usage)</span>
                </div>
            }
        </div>
    }
</section>

<div id="sheet-host"></div>
