@model Plantry.Web.Pages.Pantry.TakeStock.LotPanelModel
@using Plantry.Pantry.Application
@*
    Lot escape-hatch panel (P4-5, J3). Lives inside the walk redesign's adjuster sheet
    (plantry-vvqt) — rendered by WalkModel.OnGetLotsAsync into the lot-panel-{productId}
    placeholder under the sheet's "Adjust individual lots" toggle.

    Alpine component: takeStockLotPanel — tracks per-lot reduce inputs, a per-lot disposition
    reason (Correction / Used it / Spoiled), and the "add found stock" form. It no longer owns a
    visible Save button or triggers its own POST from a click (plantry-vvqt removed that separate
    save model) — its draft state (lots/found, isDirty) is unchanged and rides the page-level Save
    instead: the sticky Save bar's Save is the sole trigger, calling this component's save(url)
    method programmatically for every panel still tracked dirty. Closing the sheet with Done
    leaves the draft pending; only Cancel discards it. The panel's host div is mounted
    persistently (take-stock.js AdjusterSheet) regardless of which row's sheet is open or closed,
    so the draft survives a Done close intact. The SaveLots server endpoint this posts to is
    unchanged.
*@
<div class="ts-hatch"
     x-data="takeStockLotPanel(@BuildLotJson(Model))"
     x-init="init()">

    <div class="ts-hatch-head">
        <svg class="icon" aria-hidden="true"><use href="#i-box" /></svg>
        Individual lots — adjust each instead of one total
    </div>

    @if (Model.Lots.Count == 0)
    {
        <p class="ts-hatch-status">No active lots in this location.</p>
    }
    else
    {
        @foreach (var lot in Model.Lots)
        {
            var eid = lot.EntryId.ToString();
            <div class="ts-lot" :class="{ failed: lots['@eid']?.failed }">
                <div class="ts-lot-top">
                    <div class="ts-lot-qty">
                        <input type="number" min="0" step="any"
                               :value="lots['@eid']?.amount ?? 0"
                               x-on:input="setLotAmount('@eid', $event.target.value)"
                               aria-label="Counted quantity for this lot" />
                        <span class="lq-unit">@lot.UnitCode</span>
                    </div>
                    <div class="ts-lot-meta">
                        <span class="ts-lot-exp">
                            <svg class="icon" aria-hidden="true"><use href="#i-box" /></svg>
                            @lot.Quantity.ToString("0.###") @lot.UnitCode
                        </span>
                        @* Editable expiry correction (plantry-fyvr) — the lot panel's only way to fix
                           a wrong date without deleting/re-adding the lot. *@
                        <label class="ts-date-lbl" for=@("lot-expiry-" + eid)>Expiry</label>
                        <input type="date" id=@("lot-expiry-" + eid) class="ts-date-input"
                               x-model="lots['@eid'].expiryDate"
                               aria-label="Expiry date for this lot" />
                    </div>
                </div>
                @* Disposition reason — only relevant once the count drops below the recorded
                   amount, mirroring how the parent count row asks "Why the drop?" after a
                   decrease. Same options and CSS classes as the parent island (take-stock.js),
                   re-expressed in Alpine because the lot panel is server-rendered Razor. *@
                <div class="ts-reason" role="group" aria-label="Disposition reason for this lot"
                     x-show="(lots['@eid']?.original ?? 0) - (lots['@eid']?.amount ?? 0) > 0"
                     x-cloak>
                    <span class="ts-reason-lbl">
                        <svg class="icon" aria-hidden="true"><use href="#i-tag" /></svg> Why the drop?
                    </span>
                    <div class="ts-reason-opts">
                        <button type="button" class="ts-reason-opt correction"
                                :class="{ sel: (lots['@eid']?.reason ?? 'Correction') === 'Correction' }"
                                x-on:click="setReason('@eid', 'Correction')">
                            <span class="rdot"></span> Correction
                        </button>
                        <button type="button" class="ts-reason-opt consumed"
                                :class="{ sel: lots['@eid']?.reason === 'Consumed' }"
                                x-on:click="setReason('@eid', 'Consumed')">
                            <span class="rdot"></span> Used it
                        </button>
                        <button type="button" class="ts-reason-opt discarded"
                                :class="{ sel: lots['@eid']?.reason === 'Discarded' }"
                                x-on:click="setReason('@eid', 'Discarded')">
                            <span class="rdot"></span> Spoiled
                        </button>
                    </div>
                </div>
                <span class="ts-lot-fail"
                      x-show="lots['@eid']?.failed"
                      x-text="lots['@eid']?.failMsg ?? ''"
                      role="alert"></span>
            </div>
        }
    }

    @* Add found stock — opening-balance Correction lot *@
    <div class="ts-lot found">
        <div class="ts-lot-top">
            <span class="found-tag">Found stock</span>
            <div class="ts-lot-qty">
                <input type="number" min="0" step="any"
                       x-model.number="found.amount"
                       aria-label="Quantity of found stock to add" />
                <span class="lq-unit">@(Model.Lots.FirstOrDefault()?.UnitCode ?? "")</span>
            </div>
            <label class="ts-date-lbl" for=@("found-expiry-" + Model.ProductId)>Expiry</label>
            <input type="date" id=@("found-expiry-" + Model.ProductId) class="ts-date-input"
                   x-model="found.expiryDate" />
            <input type="hidden" x-bind:value="found.unitId" />
        </div>
    </div>

    @* No footer Save button (plantry-vvqt) — this panel's draft rides the page-level Save: the
       sticky Save bar's Save button is the sole trigger, calling this component's save() method
       programmatically. Per-lot failures still surface inline above (.ts-lot-fail /
       .ts-lot.failed) whenever the sheet happens to be open; a batch-level failure message is
       always shown as a toast by the island caller (take-stock.js save()), since the panel is
       usually closed (visibility:hidden) by the time the page-level Save runs. *@
    <div class="ts-hatch-status" x-show="saving" x-cloak role="status" aria-live="polite">Saving…</div>
</div>

@functions {
    /// <summary>Serialises initial lot state for the Alpine data function.</summary>
    string BuildLotJson(LotPanelModel m)
    {
        // Take Stock semantics: each lot's input is the *counted* quantity, pre-filled with the
        // lot's current on-hand amount (plantry-hl6u). `original` is the recorded baseline used to
        // compute the reduction delta (original − counted) posted to SaveLots, and to decide dirty.
        var lots = m.Lots.ToDictionary(
            l => l.EntryId.ToString(),
            l => new
            {
                amount = l.Quantity,
                original = l.Quantity,
                unitId = l.UnitId.ToString(),
                reason = "Correction",
                // expiryDate seeds the editable date input (plantry-fyvr); originalExpiryDate is the
                // dirty-tracking baseline, mirroring original/amount above. ISO "yyyy-MM-dd" (or "" for
                // no expiry) — the format an HTML date input's value attribute requires.
                expiryDate = l.ExpiryDate?.ToString("yyyy-MM-dd") ?? "",
                originalExpiryDate = l.ExpiryDate?.ToString("yyyy-MM-dd") ?? "",
                failed = false,
                failMsg = (string?)null,
            });
        // found.unitId defaults to the first lot's unit Guid (the display unit for this product/location).
        var foundUnitId = m.Lots.Count > 0 ? m.Lots[0].UnitId.ToString() : "";
        var json = System.Text.Json.JsonSerializer.Serialize(new
        {
            lots,
            foundUnitId,
        });
        return json;
    }
}

@* takeStockLotPanel is defined in Walk.cshtml (the host page) — it must be
   pre-loaded at page time so it is available when Alpine.initTree re-initialises
   the injected partial markup. Scripts inside dynamically injected innerHTML do
   not execute in browsers (HTML spec §4.12.1 / fetch-and-run semantics). *@
