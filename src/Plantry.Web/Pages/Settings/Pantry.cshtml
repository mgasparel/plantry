@page
@model Plantry.Web.Pages.Settings.PantryModel
@{
    ViewData["Title"] = "Pantry settings";
}

<div class="cfg-wrap" data-screen-label="Pantry settings">
    <div class="cfg-head">
        <div class="eyebrow">Household setup</div>
        <h1>Pantry settings</h1>
        <p>
            Choose how far ahead Plantry looks when flagging stock as expiring soon. This single
            horizon drives the Today &ldquo;expiring soon&rdquo; list, the pantry expiry badges, and
            the recipe browse &ldquo;use soon&rdquo; filter &mdash; so every surface agrees. Also
            choose the storage location Plantry uses for a cooked recipe yield when the product has
            no default location of its own.
        </p>
    </div>

    <form method="post" class="form-stack">
        @if (Model.Saved)
        {
            @await Html.PartialAsync("Settings/_SettingSaved", "Setting saved")
        }

        <field asp-for="Input.ExpiringSoonDays" label="Show items as expiring soon within (days)">
            <input asp-for="Input.ExpiringSoonDays" class="field__input" type="number"
                   min="@Plantry.Pantry.Domain.HouseholdInventorySettings.MinExpiringSoonDays"
                   max="@Plantry.Pantry.Domain.HouseholdInventorySettings.MaxExpiringSoonDays" />
            <span asp-validation-for="Input.ExpiringSoonDays" class="field__error"></span>
        </field>

        <field asp-for="Input.DefaultLocationId">
            <select asp-for="Input.DefaultLocationId" class="field__input" asp-items="Model.LocationOptions">
                <option value="">&mdash; None &mdash;</option>
            </select>
            <span class="field__hint">Used to store a cooked recipe yield when the product has no default location of its own.</span>
            <span asp-validation-for="Input.DefaultLocationId" class="field__error"></span>
        </field>

        <field asp-for="Input.DefaultProducedCategoryId">
            <select asp-for="Input.DefaultProducedCategoryId" class="field__input" asp-items="Model.CategoryOptions">
                <option value="">&mdash; None &mdash;</option>
            </select>
            <span class="field__hint">New recipe-yield and leftovers products created automatically will be assigned this category.</span>
            <span asp-validation-for="Input.DefaultProducedCategoryId" class="field__error"></span>
        </field>

        <button type="submit" class="btn btn--primary">Save</button>
    </form>
</div>
