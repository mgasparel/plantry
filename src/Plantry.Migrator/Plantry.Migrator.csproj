<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Identity.Infrastructure has a FrameworkReference on Microsoft.AspNetCore.App
         (for IdentityDbContext). A plain console app must opt in to that shared framework. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- All Infrastructure projects that own migrations (see MigrationTargets.cs — order is load-bearing).
         Market.Infrastructure owns two entries (PricingDbContext + DealsDbContext, separate schemas). -->
    <ProjectReference Include="..\Plantry.Identity.Infrastructure\Plantry.Identity.Infrastructure.csproj" />
    <ProjectReference Include="..\Plantry.Catalog.Infrastructure\Plantry.Catalog.Infrastructure.csproj" />
    <ProjectReference Include="..\Plantry.Inventory.Infrastructure\Plantry.Inventory.Infrastructure.csproj" />
    <ProjectReference Include="..\Plantry.Market.Infrastructure\Plantry.Market.Infrastructure.csproj" />
    <ProjectReference Include="..\Plantry.Intake.Infrastructure\Plantry.Intake.Infrastructure.csproj" />
    <ProjectReference Include="..\Plantry.Recipes.Infrastructure\Plantry.Recipes.Infrastructure.csproj" />
    <ProjectReference Include="..\Plantry.Planning.Infrastructure\Plantry.Planning.Infrastructure.csproj" />
    <!-- HousekeepingDbContext (schema `housekeeping`) lives in Plantry.Composition.Infrastructure —
         the composition read layer's standing persistence home (ADR-024, plantry-g3da.9, ratified
         option B of plantry-swe3). Restores the Migrator to referencing ONLY *.Infrastructure
         projects, never the deployable web app (the Migrator is an owner-credential container,
         ADR-016/017, and must not reference it). -->
    <ProjectReference Include="..\Plantry.Composition.Infrastructure\Plantry.Composition.Infrastructure.csproj" />
  </ItemGroup>

</Project>
